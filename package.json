    "sharp": "^0.35.5",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
